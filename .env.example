# Default provider: jev. Use evolink for OpenAI GPT-6 Luna Decisions.
DECISION_PROVIDER=jev

# Your own TypeSafe AI key. Used server-side by npm run dev / preview.
# Local mode skips login and demo credits; no OAuth secrets are needed.
TYPESAFE_API_KEY=your_key_here
# USD per million tokens; TypeSafe launch pricing, September 14 2026.
JEV_INPUT_PRICE=0.042
JEV_OUTPUT_PRICE=0

# Optional EvoLink provider (set DECISION_PROVIDER=evolink to enable).
# Server-side only; do not use VITE_ variables for API keys.
# EVOLINK_API_KEY=your_key_here
# Public default USD / million billable input tokens; output is free.
# EVOLINK_INPUT_PRICE=0.1
# Default minimum: 0.01 Credits per request at 68 Credits/USD.
# EVOLINK_MIN_REQUEST_COST=0.00014705882352941175

# Optional server binding overrides (defaults to localhost).
# JEV_HOST=localhost
# JEV_ALLOWED_HOSTS=your-hostname.example
